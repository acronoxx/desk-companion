{
  "expo": {
    "name": "Desk Companion",
    "slug": "desk-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "deskcompanion",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Desk Companion shows your calendar events next to your reminders."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
